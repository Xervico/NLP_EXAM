# Adding the response format restraint, inspired by https://arxiv.org/abs/2503.11985
def jls_extract_def():
    return "Answer with ONLY numbers (0-5), do NOT give extra explanation or related information, and be CRITICAL, do not fear to answer low. If its not relevant, just pick 0, and make sure to WRITE 0 and NOT zero"


restraint = jls_extract_def()
